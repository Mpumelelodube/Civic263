# Public Firebase client settings. Keep actual values in ignored .env.local files.
EXPO_PUBLIC_PUBLIC_API_URL=
# Native build only; set the approved existing Maps key locally and never commit it.
GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Enable only after server deployment and verified-app/identity configuration.
EXPO_PUBLIC_REPORT_INTAKE_ENABLED=false
# Development only. Use 127.0.0.1 with adb reverse for ports 9099 and 5001.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Trusted local testing only; never configure a debug token in a store build.
EXPO_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
