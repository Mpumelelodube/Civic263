{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "CIVIC263_BUILD_VARIANT": "acceptance",
        "EXPO_PUBLIC_APP_ENV": "acceptance"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "CIVIC263_BUILD_VARIANT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleTeamId": "25L4M5VTCR"
      }
    }
  }
}
